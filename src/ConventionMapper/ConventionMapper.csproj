<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Same target set as AutoMapper: .NET Standard 2.0 (covers .NET Framework 4.6.1+), plus modern .NET -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <RootNamespace>ConventionMapper</RootNamespace>
    <AssemblyName>ConventionMapper</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>

    <!-- ===== NuGet package metadata ===== -->
    <!-- IMPORTANT: check https://www.nuget.org/packages/<PackageId> is free before publishing, and change it if needed. -->
    <PackageId>ConventionMapper</PackageId>
    <Version>1.2.0</Version>
    <Authors>Katragadda</Authors>
    <Company>Katragadda</Company>
    <Product>ConventionMapper</Product>
    <Description>A convention-based object-object mapper for .NET. Flattening, unflattening (ReverseMap), profiles, value resolvers, type converters, value converters, conditions, before/after map actions, inheritance (Include/IncludeBase), constructor mapping, collections, dictionaries, enums, IQueryable projection (ProjectTo), configuration validation and Microsoft.Extensions.DependencyInjection integration. Also built in: collection merging by key (EqualityComparison), PATCH-style mapping that ignores null source values, strict enum mapping with validation, immutable collections, full member paths in error messages and Explain() for inspecting maps.</Description>
    <PackageTags>mapper;object-mapper;mapping;dto;convention;flattening;projection;automapper-alternative</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/katragvb/Conventionmapper/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/katragvb/Conventionmapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/katragvb/Conventionmapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Checks the package for API consistency across its target frameworks on every pack. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Fails the pack when a new version breaks the public API of the baseline release. -->
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Build-time analyzer + code fixes for the runtime API, shipped in this package under analyzers/dotnet/cs. -->
  <ItemGroup>
    <ProjectReference Include="..\ConventionMapper.Analyzers\ConventionMapper.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\ConventionMapper.CodeFixes\ConventionMapper.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\ConventionMapper.Analyzers\bin\$(Configuration)\netstandard2.0\ConventionMapper.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\ConventionMapper.CodeFixes\bin\$(Configuration)\netstandard2.0\ConventionMapper.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="ConventionMapper.Tests" />
  </ItemGroup>

</Project>
