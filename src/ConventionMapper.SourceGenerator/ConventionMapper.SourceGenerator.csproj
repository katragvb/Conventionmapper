<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn components must target netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>ConventionMapper.SourceGenerator</RootNamespace>
    <Deterministic>true</Deterministic>
    <!-- RS2008: release tracking files; NU5128: analyzer-only package has no lib folder by design. -->
    <NoWarn>$(NoWarn);RS2008;NU5128</NoWarn>

    <!-- ===== NuGet package: analyzer-only, no runtime dependency ===== -->
    <PackageId>ConventionMapper.SourceGenerator</PackageId>
    <Version>1.10.0</Version>
    <Authors>Katragadda</Authors>
    <Company>Katragadda</Company>
    <Product>ConventionMapper</Product>
    <Description>Build-time object mapping for .NET. Declare partial mapping methods in a [GeneratedMapper] class and ConventionMapper writes plain C# mapping code into your project at compile time: no reflection, Native AOT and trimming safe, as fast as hand-written code and debuggable. Unmapped members are build errors.</Description>
    <PackageTags>mapper;object-mapper;mapping;dto;source-generator;roslyn;aot;compile-time;codegen</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/katragvb/Conventionmapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/katragvb/Conventionmapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See https://github.com/katragvb/Conventionmapper/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- IDE fixes for the generator's diagnostics (CM0001, CM0020, CM0023), shipped next to the generator. -->
  <ItemGroup>
    <ProjectReference Include="..\ConventionMapper.SourceGenerator.CodeFixes\ConventionMapper.SourceGenerator.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\ConventionMapper.SourceGenerator.CodeFixes\bin\$(Configuration)\netstandard2.0\ConventionMapper.SourceGenerator.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <!-- ConventionMapperGeneratedDocs and ConventionMapperEmitGeneratedCode (see docs/source-generator.md). -->
    <None Include="build\ConventionMapper.SourceGenerator.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConventionMapper.Tests" />
  </ItemGroup>

  <!-- The packed props carry the package version (see build/ConventionMapper.SourceGenerator.props and CM0024). -->
  <Target Name="ConventionMapperVersionedProps" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_ConventionMapperProps>$(IntermediateOutputPath)pack/ConventionMapper.SourceGenerator.props</_ConventionMapperProps>
    </PropertyGroup>
    <WriteLinesToFile File="$(_ConventionMapperProps)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)build/ConventionMapper.SourceGenerator.props').Replace('__CONVENTIONMAPPER_VERSION__', '$(PackageVersion)'))" />
    <ItemGroup>
      <None Include="$(_ConventionMapperProps)" Pack="true" PackagePath="build\" />
    </ItemGroup>
  </Target>
</Project>
