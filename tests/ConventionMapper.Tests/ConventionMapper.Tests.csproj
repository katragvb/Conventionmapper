<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- On Windows the tests also run on .NET Framework 4.8, which exercises the netstandard2.0 build. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net8.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <!-- Run the net8.0 tests on a newer runtime when .NET 8 isn't installed (a machine with only the .NET 10 SDK). -->
    <RollForward>Major</RollForward>
    <!-- GeneratedCodeOf on every mapper, for the MapperAssert.GeneratedCodeMatches tests. -->
    <ConventionMapperEmbedGeneratedCode>true</ConventionMapperEmbedGeneratedCode>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Normally set by the ConventionMapper package's build targets (project references don't import them). -->
    <DefineConstants>$(DefineConstants);CONVENTIONMAPPER_RUNTIME</DefineConstants>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- Proves generated projections translate to SQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <!-- SqlServerDatabaseAssertTests: run when CONVENTIONMAPPER_SQLSERVER holds a connection string (the sqlserver CI job). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <ProjectReference Include="..\..\src\ConventionMapper.Testing.EntityFrameworkCore\ConventionMapper.Testing.EntityFrameworkCore.csproj" />
    <!-- IDE code fixes and refactorings are tested in a Roslyn workspace -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <ProjectReference Include="..\..\src\ConventionMapper.CodeFixes\ConventionMapper.CodeFixes.csproj" />
    <ProjectReference Include="..\..\src\ConventionMapper.SourceGenerator.CodeFixes\ConventionMapper.SourceGenerator.CodeFixes.csproj" />
    <!-- Protobuf messages generated by protoc, mapped by the generator -->
    <PackageReference Include="Google.Protobuf" Version="3.25.1" />
    <PackageReference Include="Grpc.Tools" Version="2.60.0" PrivateAssets="all" />
    <Protobuf Include="Protos\*.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ConventionMapper\ConventionMapper.csproj" />
    <!-- Runs the source generator on this project (end-to-end tests) and references it for the generator driver tests. -->
    <ProjectReference Include="..\..\src\ConventionMapper.SourceGenerator\ConventionMapper.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\..\src\ConventionMapper.Analyzers\ConventionMapper.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A project reference doesn't import the package's props, so expose the generator's property here. -->
    <CompilerVisibleProperty Include="ConventionMapperEmbedGeneratedCode" />
    <ProjectReference Include="..\..\src\ConventionMapper.Testing\ConventionMapper.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" PrivateAssets="all" />
  </ItemGroup>

</Project>
